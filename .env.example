# ============================================================
# Job Tracker — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must NEVER be committed.
# ============================================================

# ---- PostgreSQL ----
DB_NAME=jobtracker
DB_USERNAME=jobtracker
DB_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ---- Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ---- Frontend ----
FRONTEND_PORT=3000

# ---- JWT ----
# Minimum 32 characters. Generate a secure value with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_real_secret_minimum_32_chars!!
JWT_EXPIRATION_MS=86400000

# ---- MinIO (Stage 5) ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=resumes
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Redis cache (Stage 9) ----
# redis: cache dashboard statistics in Redis | none: no cache, always query PostgreSQL
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Maximum age of cached dashboard statistics
# DASHBOARD_CACHE_TTL=5m
# Prefix for every key this app writes, so a shared Redis can serve several projects
# CACHE_KEY_PREFIX=jobtracker:
# Host port of the Compose Redis, for redis-cli; 6380 avoids a Redis already on the host
# REDIS_HOST_PORT=6380
# Memory cap for the Compose Redis container (LRU eviction beyond it)
# REDIS_MAXMEMORY=64mb

# ---- AI Provider (Stage 6+) ----
# Options: mock | claude | ollama
AI_PROVIDER=mock
# Max characters of resume text / job description sent for analysis
AI_MAX_INPUT_CHARS=50000

# Required only when AI_PROVIDER=claude. Uses the paid Anthropic API; leave blank to never call it.
ANTHROPIC_API_KEY=
# Optional tuning (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_TIMEOUT=120s
# CLAUDE_MAX_RETRIES=2

# Used only when AI_PROVIDER=ollama. Pull the model first: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional tuning (defaults shown)
# OLLAMA_CONNECT_TIMEOUT=5s
# OLLAMA_READ_TIMEOUT=180s
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=1024

# ---- Background analysis and notifications (Stage 8) ----
# Browser origins allowed to open the notification WebSocket (comma-separated)
WS_ALLOWED_ORIGINS=http://localhost:3000
# Max concurrent analyses (and so concurrent AI calls) and how many may wait
# ANALYSIS_EXECUTOR_CORE_SIZE=4
# ANALYSIS_EXECUTOR_MAX_SIZE=8
# ANALYSIS_EXECUTOR_QUEUE_CAPACITY=100

# ---- Derived (set automatically in Docker Compose) ----
# DB_URL is built from DB_NAME/host in docker-compose.yml; set explicitly for local runs:
DB_URL=jdbc:postgresql://localhost:5432/jobtracker

# ---- Security (Stage 1 dev only — replaced by JWT in Stage 3) ----
SECURITY_USER=dev
SECURITY_PASSWORD=dev
