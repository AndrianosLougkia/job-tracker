# ============================================================
# Job Tracker — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must NEVER be committed.
# ============================================================

# ---- PostgreSQL ----
DB_NAME=jobtracker
DB_USERNAME=jobtracker
DB_PASSWORD=jobtracker
POSTGRES_PORT=5432

# ---- Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ---- Frontend ----
FRONTEND_PORT=3000

# ---- JWT (Stage 3) ----
# Minimum 256-bit (32-character) random string. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_real_secret_minimum_32_chars
JWT_EXPIRATION_MS=86400000

# ---- MinIO (Stage 5) ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=resumes
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Redis (Stage 9) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- AI Provider (Stage 6+) ----
# Options: mock | claude | ollama
AI_PROVIDER=mock

# Required only when AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ---- Derived (set automatically in Docker Compose) ----
# DB_URL is built from DB_NAME/host in docker-compose.yml; set explicitly for local runs:
DB_URL=jdbc:postgresql://localhost:5432/jobtracker

# ---- Security (Stage 1 dev only — replaced by JWT in Stage 3) ----
SECURITY_USER=jobtracker
SECURITY_PASSWORD=jobtracker
